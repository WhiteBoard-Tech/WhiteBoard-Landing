---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import CTAButton from './CTAButton.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// One Fluoro highlight per screen: the word the headline turns on
const [headlineStart, headlineEnd] = t('hero.headline').split(t('hero.highlight'));
---

<section id="hero" class="min-h-[calc(100vh-4rem)] flex items-center px-4 sm:px-6 lg:px-8 py-12 lg:py-0">
  <div class="max-w-7xl mx-auto w-full">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <!-- Text content - flexible container for text expansion -->
      <div class="max-w-xl lg:max-w-none">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink-900 leading-tight">
          {headlineStart}<mark>{t('hero.highlight')}</mark>{headlineEnd}
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-graphite-600 leading-relaxed">
          {t('hero.subheadline')}
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 sm:items-center">
          <!-- Primary CTA - most prominent -->
          <CTAButton href="#contact" variant="primary">
            {t('hero.cta.primary')}
          </CTAButton>

          <!-- Secondary CTA - visually subordinate text link with icon -->
          <a
            href="#video"
            class="text-graphite-600 hover:text-ink-900 transition-colors duration-200 text-sm font-medium inline-flex items-center gap-2"
          >
            <span>{t('hero.cta.secondary')}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
        </div>

        <!-- Exclusivity microcopy -->
        <p class="mt-4 font-mono text-sm text-graphite-500">
          {t('hero.microcopy')}
        </p>

        <!-- Venture logos section -->
        <div class="mt-8 flex items-center gap-6">
          <span class="font-mono text-xs text-graphite-500 uppercase tracking-wider">{t('hero.logos.label')}</span>
          <div class="flex items-center gap-4">
            <img
              src="/images/logos/radarum.svg"
              alt="Radarum"
              class="h-6 w-auto opacity-60 grayscale"
              loading="eager"
            />
            <img
              src="/images/logos/alwon.svg"
              alt="Alwon"
              class="h-6 w-auto opacity-60 grayscale"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- Hero graphic - right side on desktop -->
      <div class="lg:order-last">
        <img
          src="/images/hero-placeholder.svg"
          alt="Tech partnership illustration"
          class="w-full h-auto"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="400"
          height="300"
        />
      </div>
    </div>
  </div>
</section>
