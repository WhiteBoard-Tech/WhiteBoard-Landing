---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import CTAButton from './CTAButton.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// One Fluoro highlight per screen: the word the headline turns on
const [headlineStart, headlineEnd] = t('hero.headline').split(t('hero.highlight'));

const modules = ['hero.card.auth', 'hero.card.tenant', 'hero.card.admin', 'hero.card.ai'] as const;

const stats = [
  { value: '0', key: 'stats.cost' },
  { value: '6–10', key: 'stats.mvp' },
  { value: '3–5', key: 'stats.ventures' },
] as const;
---

<section id="hero" class="relative overflow-hidden bg-ink-950 text-canvas-050 pt-20 lg:pt-28">
  <!-- Background loop: the poster stays when motion is reduced or the video is loading -->
  <img src="/videos/hero-bg.jpg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover" />
  <video
    class="absolute inset-0 w-full h-full object-cover motion-reduce:hidden"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/videos/hero-bg.jpg"
    aria-hidden="true"
  >
    <source src="/videos/hero-bg.mp4" type="video/mp4" />
  </video>
  <!-- Flat scrim keeps the copy at full contrast over the video -->
  <div class="absolute inset-0 bg-ink-950/60" aria-hidden="true"></div>

  <div class="relative max-w-[1240px] mx-auto px-5 lg:px-8">
    <div class="grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-14 lg:gap-16 items-center">
      <div>
        <span class="inline-block font-mono text-xs text-canvas-300 bg-ink-950 border border-graphite-700 px-3 py-1.5 rounded-full mb-8">
          {t('hero.tag')}
        </span>

        <h1 class="text-[52px] lg:text-[88px] leading-[0.94] font-bold tracking-[-1.8px] lg:tracking-[-3.4px]">
          {headlineStart}<mark class="px-2.5">{t('hero.highlight')}</mark>{headlineEnd}
        </h1>

        <p class="mt-8 text-lg lg:text-xl leading-relaxed text-canvas-300 max-w-[34em]">
          {t('hero.subheadline')}
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <CTAButton href="#contact" variant="inverse" arrow>
            {t('hero.cta.primary')}
          </CTAButton>
          <CTAButton href="#process" variant="secondary-dark">
            {t('hero.cta.secondary')}
          </CTAButton>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-5">
          <span class="font-mono text-[11px] uppercase tracking-[0.9px] text-graphite-400">{t('hero.logos.label')}</span>
          <span class="text-[17px] font-semibold text-canvas-200">Radarum</span>
          <span class="w-1 h-1 bg-graphite-650" aria-hidden="true"></span>
          <span class="text-[17px] font-semibold text-canvas-200">Alwon</span>
        </div>
      </div>

      <!-- Platform card: what is already built on day one -->
      <div class="bg-ink-900 border border-graphite-800 rounded-lg p-8 shadow-lg">
        <div class="flex justify-between items-center font-mono text-[11px] uppercase tracking-[0.9px] text-graphite-400">
          <span>{t('hero.card.label')}</span>
          <span>v1</span>
        </div>
        <div class="mt-6 font-mono text-8xl font-semibold tracking-[-4px] leading-none">60%</div>
        <p class="mt-2 text-[15px] text-canvas-300">{t('hero.card.caption')}</p>
        <div role="img" aria-label={t('hero.card.progress')} class="h-2 bg-graphite-800 rounded-sm my-6 overflow-hidden">
          <div class="w-3/5 h-full bg-canvas-050"></div>
        </div>
        <ul>
          {modules.map((key) => (
            <li class="flex items-center justify-between py-3 border-t border-graphite-800">
              <span class="text-[15px]">{t(key)}</span>
              <span class="flex items-center gap-1.5 font-mono text-xs text-success-dark">
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="8" cy="8" r="6.5" /><path d="M5 8.2l2.1 2.1L11 6.4" />
                </svg>
                {t('hero.card.ready')}
              </span>
            </li>
          ))}
          <li class="flex items-center justify-between py-3 border-t border-graphite-800">
            <span class="text-[15px] font-semibold">{t('hero.card.product')}</span>
            <span class="flex items-center gap-1.5 font-mono text-xs text-graphite-400">
              <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="2 2" aria-hidden="true">
                <circle cx="8" cy="8" r="6.5" />
              </svg>
              {t('hero.card.together')}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="grid sm:grid-cols-3 gap-8 mt-24 lg:mt-28 pt-10 pb-20 lg:pb-24 border-t border-graphite-800">
      {stats.map((stat) => (
        <div>
          <div class="font-mono text-[40px] lg:text-[56px] font-semibold tracking-[-2px] leading-none">{stat.value}</div>
          <div class="mt-2 text-sm text-graphite-400 max-w-[28ch]">{t(stat.key)}</div>
        </div>
      ))}
    </div>
  </div>
</section>
