---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { class: className = '', size = 'md' } = Astro.props;

const sizes = {
  sm: 'w-8 h-8',
  md: 'w-10 h-10',
  lg: 'w-12 h-12',
};
---

<svg
  class:list={[sizes[size], className]}
  viewBox="0 0 100 90"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Exact W mark from brand reference -->
  <!-- Left wing: outer-top → bottom-point → center-meet → inner-top -->
  <path
    d="M0 0 L22 90 L50 45 L40 0 Z"
    fill="currentColor"
  />
  <!-- Right wing: mirror of left -->
  <path
    d="M100 0 L78 90 L50 45 L60 0 Z"
    fill="currentColor"
  />
  <!-- Center notch: small downward triangle -->
  <path
    d="M40 0 L50 20 L60 0 Z"
    fill="currentColor"
  />
</svg>
