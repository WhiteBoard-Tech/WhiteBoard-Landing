---
export interface Props {
  name: string;
  category: string;
  description: string;
  metric: string;
}

const { name, category, description, metric } = Astro.props;
---

<div class="bg-carbon border border-slate rounded-lg p-6 lg:p-8 flex flex-col h-full hover:border-pulse transition-all duration-300">
  <!-- Category badge -->
  <span class="inline-block self-start px-3 py-1 text-xs font-semibold bg-pulse text-obsidian rounded mb-4">
    {category}
  </span>

  <!-- Venture name -->
  <h3 class="text-xl font-bold text-white mb-3">
    {name}
  </h3>

  <!-- Description -->
  <p class="text-mist text-sm leading-relaxed mb-4 flex-grow">
    {description}
  </p>

  <!-- Outcome metric -->
  <p class="text-sm text-mist border-t border-slate pt-4">
    {metric}
  </p>
</div>
