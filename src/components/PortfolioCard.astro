---
export interface Props {
  name: string;
  category: string;
  description: string;
  metric: string;
}

const { name, category, description, metric } = Astro.props;
---

<div class="bg-gray-900 rounded-lg p-6 lg:p-8 flex flex-col h-full hover:bg-gray-800 transition-colors duration-300">
  <!-- Category badge -->
  <span class="inline-block self-start px-3 py-1 text-xs font-medium bg-white/10 text-white rounded-full mb-4">
    {category}
  </span>

  <!-- Venture name -->
  <h3 class="text-xl font-bold text-white mb-3">
    {name}
  </h3>

  <!-- Description -->
  <p class="text-gray-300 text-sm leading-relaxed mb-4 flex-grow">
    {description}
  </p>

  <!-- Outcome metric -->
  <p class="text-sm text-gray-400 border-t border-gray-700 pt-4">
    {metric}
  </p>
</div>
