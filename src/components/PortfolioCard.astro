---
export interface Props {
  name: string;
  category: string;
  description: string;
  metric: string;
}

const { name, category, description, metric } = Astro.props;
---

<div class="bg-ink-900 rounded-lg p-6 lg:p-8 flex flex-col h-full hover:bg-graphite-800 transition-colors duration-300">
  <!-- Category badge -->
  <span class="inline-block self-start px-3 py-1 font-mono text-xs font-medium bg-canvas-050/10 text-canvas-050 rounded-full mb-4">
    {category}
  </span>

  <!-- Venture name -->
  <h3 class="text-xl font-bold text-canvas-050 mb-3">
    {name}
  </h3>

  <!-- Description -->
  <p class="text-canvas-300 text-sm leading-relaxed mb-4 flex-grow">
    {description}
  </p>

  <!-- Outcome metric -->
  <p class="font-mono text-sm text-graphite-400 border-t border-graphite-700 pt-4">
    {metric}
  </p>
</div>
