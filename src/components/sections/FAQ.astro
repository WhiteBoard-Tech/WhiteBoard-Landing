---
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqs = ['equity', 'ip', 'scaling', 'timeline'];
---

<section id="faq" class="py-20 lg:py-32 bg-canvas-000 border-t border-canvas-200">
  <div class="max-w-[1240px] mx-auto px-5 lg:px-8 grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-12 lg:gap-16 items-start">
    <div>
      <p class="font-mono text-xs text-graphite-500 mb-4">{t('faq.kicker')}</p>
      <h2 class="text-[38px] lg:text-[56px] leading-none font-bold tracking-[-1.2px] lg:tracking-[-2px]">
        {t('faq.title')}
      </h2>
    </div>

    <div class="border-t border-canvas-200">
      {faqs.map((key, i) => (
        <details class="group border-b border-canvas-200" open={i === 0}>
          <summary class="flex justify-between items-center gap-6 py-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-[19px] font-semibold">
            {t(`faq.${key}.question` as any)}
            <svg class="w-5 h-5 flex-none" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 10h12" />
              <path d="M10 4v12" class="group-open:hidden" />
            </svg>
          </summary>
          <p class="pb-6 text-base leading-relaxed text-graphite-600 max-w-[40em]">
            {t(`faq.${key}.answer` as any)}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
