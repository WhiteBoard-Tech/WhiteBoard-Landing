---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import TeamMember from '../TeamMember.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const members = [
  { key: 'member1' },
  { key: 'member2' },
  { key: 'member3' },
];
---

<section id="team" class="py-20 lg:py-32">
  <div class="max-w-[1240px] mx-auto px-5 lg:px-8 grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-12 lg:gap-16 items-start">
    <div>
      <p class="font-mono text-xs text-graphite-500 mb-4">{t('team.kicker')}</p>
      <h2 class="text-[38px] lg:text-[56px] leading-none font-bold tracking-[-1.2px] lg:tracking-[-2px]">
        {t('team.title')}
      </h2>
      <p class="mt-6 text-[17px] text-graphite-600 max-w-[26em]">{t('team.subtitle')}</p>
    </div>

    <div class="grid sm:grid-cols-3 gap-4">
      {members.map((member) => (
        <TeamMember
          name={t(`team.${member.key}.name` as any)}
          role={t(`team.${member.key}.role` as any)}
          initials={t(`team.${member.key}.initials` as any)}
        />
      ))}
    </div>
  </div>
</section>
