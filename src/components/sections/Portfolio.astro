---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import PortfolioCard from '../PortfolioCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ventures = [
  { key: 'radarum', category: 'Fintech / Edtech' },
  { key: 'alwon', category: 'Retail Tech' },
];
---

<section id="portfolio" class="py-16 sm:py-20 lg:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section title - headline only per CONTEXT decision -->
    <h2 class="text-3xl sm:text-4xl font-bold text-black text-center mb-12 lg:mb-16">
      {t('portfolio.title')}
    </h2>

    <!-- Portfolio grid - 2 columns on md+ for 2 ventures -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {ventures.map((venture) => (
        <PortfolioCard
          name={t(`portfolio.${venture.key}.name` as any)}
          category={venture.category}
          description={t(`portfolio.${venture.key}.description` as any)}
          metric={t(`portfolio.${venture.key}.metric` as any)}
        />
      ))}
    </div>
  </div>
</section>
