---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import PortfolioCard from '../PortfolioCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ventures = [
  { key: 'radarum', category: 'Fintech / Edtech' },
  { key: 'alwon', category: 'Retail Tech' },
];
---

<section id="portfolio" class="py-20 lg:py-32 bg-canvas-000 border-y border-canvas-200">
  <div class="max-w-[1240px] mx-auto px-5 lg:px-8">
    <p class="font-mono text-xs text-graphite-500 mb-4">{t('portfolio.kicker')}</p>
    <h2 class="text-[38px] lg:text-[56px] leading-none font-bold tracking-[-1.2px] lg:tracking-[-2px]">
      {t('portfolio.title')}
    </h2>

    <div class="grid md:grid-cols-2 gap-6 mt-14">
      {ventures.map((venture) => (
        <PortfolioCard
          name={t(`portfolio.${venture.key}.name` as any)}
          category={venture.category}
          description={t(`portfolio.${venture.key}.description` as any)}
          metric={t(`portfolio.${venture.key}.metric` as any)}
        />
      ))}
    </div>
  </div>
</section>
