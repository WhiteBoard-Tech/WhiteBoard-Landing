---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const valueProps = [
  { key: "noUpfront", mark: "$0" },
  { key: "aligned", mark: "1:1" },
  { key: "partnership", mark: "∞" },
] as const;
---

<section id="equity-model" class="py-20 lg:py-32 bg-ink-900 text-canvas-050">
  <div class="max-w-[1240px] mx-auto px-5 lg:px-8">
    <p class="font-mono text-xs text-graphite-400 mb-4">{t("equity.kicker")}</p>
    <h2 class="text-[44px] lg:text-[72px] leading-[0.96] font-bold tracking-[-1.5px] lg:tracking-[-2.8px] max-w-[13em]">
      {t("equity.title")}
    </h2>
    <p class="mt-5 text-[22px] text-graphite-400">{t("equity.subtitle")}</p>

    <div class="grid md:grid-cols-3 gap-10 md:gap-0 mt-20">
      {valueProps.map((prop) => (
        <div class="border-t border-graphite-700 pt-7 md:pr-8">
          <div class="font-mono text-5xl font-semibold tracking-[-1.5px] leading-none" aria-hidden="true">{prop.mark}</div>
          <h3 class="mt-6 mb-2 text-[22px] font-semibold">{t(`equity.${prop.key}.title` as const)}</h3>
          <p class="text-base leading-relaxed text-canvas-300">{t(`equity.${prop.key}.description` as const)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
