---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const valueProps = [
  {
    key: "noUpfront",
    icon: "dollar-off",
  },
  {
    key: "aligned",
    icon: "handshake",
  },
  {
    key: "partnership",
    icon: "users",
  },
] as const;
---

<section id="equity-model" class="py-16 sm:py-20 lg:py-24 bg-carbon border-t border-slate">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 text-center">
      {t("equity.title")}
    </h2>
    <p class="text-lg text-mist text-center max-w-2xl mx-auto mb-12">
      {t("equity.subtitle")}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      {valueProps.map((prop) => (
        <div class="text-center group">
          <div class="w-16 h-16 mx-auto mb-6 bg-pulse rounded-full flex items-center justify-center shadow-[0_0_15px_rgba(255,107,91,0.3)] transition-transform duration-300 group-hover:scale-110">
            {prop.icon === "dollar-off" && (
              <svg
                class="w-8 h-8 text-obsidian"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 2v20" />
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                <path d="M2 2l20 20" />
              </svg>
            )}
            {prop.icon === "handshake" && (
              <svg
                class="w-8 h-8 text-obsidian"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="9" cy="12" r="5" />
                <circle cx="15" cy="12" r="5" />
              </svg>
            )}
            {prop.icon === "users" && (
              <svg
                class="w-8 h-8 text-obsidian"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            )}
          </div>
          <h3 class="text-xl font-bold text-white mb-2">
            {t(`equity.${prop.key}.title` as const)}
          </h3>
          <p class="text-mist leading-relaxed">
            {t(`equity.${prop.key}.description` as const)}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
