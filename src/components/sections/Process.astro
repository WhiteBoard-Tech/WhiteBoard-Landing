---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = ["discovery", "build", "scale"] as const;
const bullets = ["bullet1", "bullet2", "bullet3"] as const;
---

<section id="process" class="py-20 lg:py-32">
  <div class="max-w-[1240px] mx-auto px-5 lg:px-8">
    <p class="font-mono text-xs text-graphite-500 mb-4">{t("process.kicker")}</p>
    <h2 class="text-[38px] lg:text-[56px] leading-none font-bold tracking-[-1.2px] lg:tracking-[-2px] max-w-[14em]">
      {t("process.title")}
    </h2>

    <ol class="grid lg:grid-cols-3 gap-6 mt-16">
      {steps.map((step, i) => (
        <li class="bg-canvas-000 border border-canvas-200 rounded-lg p-8">
          <div class="flex items-center gap-4">
            <span class="w-12 h-12 rounded-md bg-ink-900 text-canvas-050 flex items-center justify-center font-mono text-lg font-semibold">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="font-mono text-[11px] uppercase tracking-[0.9px] text-graphite-500">{t(`process.${step}.when` as const)}</span>
          </div>
          <h3 class="mt-7 mb-4 text-[26px] font-bold tracking-[-0.6px]">{t(`process.${step}.title` as const)}</h3>
          <ul class="flex flex-col gap-3 text-[15px] text-graphite-600">
            {bullets.map((bullet) => (
              <li class="flex gap-3">
                <span class="font-mono text-graphite-450" aria-hidden="true">—</span>
                <span>{t(`process.${step}.${bullet}` as const)}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>
