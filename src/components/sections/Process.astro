---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import SketchAnimation from "../SketchAnimation.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = ["diagnosis", "pilot", "rollout", "operation"] as const;
---

<section id="process" class="py-20 lg:py-32">
  <div class="max-w-[1240px] mx-auto px-5 lg:px-8">
    <p class="font-mono text-xs text-graphite-500 mb-4">{t("process.kicker")}</p>
    <h2 class="text-[38px] lg:text-[56px] leading-none font-bold tracking-[-1.2px] lg:tracking-[-2px] max-w-[14em]">
      {t("process.title")}
    </h2>

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center mt-16">
      <SketchAnimation />

      <ol class="border-t border-canvas-200">
        {steps.map((step, i) => (
          <li class="flex gap-5 py-6 border-b border-canvas-200">
            <span class="w-12 h-12 flex-none rounded-md bg-ink-900 text-canvas-050 flex items-center justify-center font-mono text-lg font-semibold">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <span class="font-mono text-[11px] uppercase tracking-[0.9px] text-graphite-500">{t(`process.${step}.when` as const)}</span>
              <h3 class="mt-1 mb-1.5 text-[22px] font-bold tracking-[-0.5px]">{t(`process.${step}.title` as const)}</h3>
              <p class="text-[15px] leading-relaxed text-graphite-600">{t(`process.${step}.description` as const)}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
