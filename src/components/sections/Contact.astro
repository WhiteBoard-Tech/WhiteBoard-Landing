---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const contactLines = [
  { key: "contact.card.email", value: "WBAdmin@whibotech.com", href: "mailto:WBAdmin@whibotech.com" },
  { key: "contact.card.whatsapp", value: "+57 301 708 3266", href: "https://wa.me/573017083266" },
  { key: "contact.card.web", value: "whibotech.com", href: "https://whibotech.com" },
] as const;
---

<section id="contact" class="pt-24 lg:pt-32 pb-20 lg:pb-24 bg-ink-900 text-canvas-050">
  <div class="max-w-[1240px] mx-auto px-5 lg:px-8 grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-12 lg:gap-16 items-end">
    <div>
      <p class="font-mono text-xs text-graphite-400 mb-4">{t("contact.kicker")}</p>
      <h2 class="text-[44px] lg:text-[72px] leading-[0.96] font-bold tracking-[-1.5px] lg:tracking-[-2.8px]">
        {t("contact.title")}
      </h2>
      <p class="mt-6 text-xl text-canvas-300 max-w-[24em]">
        {t("contact.subtitle")}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-5">
        <!-- The single Fluoro accent of this screen -->
        <button
          type="button"
          id="calendly-cta"
          data-calendly-locale={lang}
          class="inline-flex items-center justify-center gap-2.5 min-h-14 px-7 text-base font-semibold text-ink-900 bg-marker-500 border border-ink-900 rounded-md hover:bg-marker-400 active:bg-marker-600 transition-colors duration-200 focus-visible:outline-marker-500 disabled:opacity-50 disabled:cursor-wait cursor-pointer"
        >
          {t("contact.cta")}
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </button>
        <span class="font-mono text-xs text-graphite-400">{t("contact.microcopy")}</span>
      </div>
    </div>

    <div class="border border-graphite-700 rounded-lg p-9">
      <p class="font-mono text-[11px] uppercase tracking-[0.9px] text-graphite-400">{t("contact.card.title")}</p>
      <dl class="mt-6">
        {contactLines.map((line) => (
          <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-4 border-t border-graphite-800">
            <dt class="text-[15px] text-graphite-400">{t(line.key)}</dt>
            <dd>
              <a href={line.href} class="font-mono text-[15px] text-canvas-050 hover:underline underline-offset-4 focus-visible:outline-marker-500">{line.value}</a>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <script>
      import { loadCalendly, openCalendlyPopup } from '@scripts/calendly';
      import '@scripts/analytics';

      const button = document.getElementById('calendly-cta') as HTMLButtonElement;
      const locale = button.dataset.calendlyLocale || 'en';

      button.addEventListener('click', async () => {
        // Track popup opened
        window.plausible?.('popup_opened', { props: { locale } });

        button.disabled = true;
        try {
          await loadCalendly();
          openCalendlyPopup(locale);
        } catch (error) {
          console.error('Failed to load Calendly:', error);
        } finally {
          button.disabled = false;
        }
      });
    </script>
  </div>
</section>
