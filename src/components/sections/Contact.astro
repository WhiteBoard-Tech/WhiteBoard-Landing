---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="py-16 sm:py-20 lg:py-24 bg-black text-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4">
      {t("contact.title")}
    </h2>
    <p class="text-lg text-gray-300 mb-8">
      {t("contact.subtitle")}
    </p>
    <button
      type="button"
      id="calendly-cta"
      data-calendly-locale={lang}
      class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-black bg-white rounded hover:bg-gray-100 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-black focus:ring-white disabled:opacity-50 disabled:cursor-wait"
    >
      {t("contact.cta")}
    </button>

    <script>
      import { loadCalendly, openCalendlyPopup } from '@scripts/calendly';
      import '@scripts/analytics';

      const button = document.getElementById('calendly-cta') as HTMLButtonElement;
      const locale = button.dataset.calendlyLocale || 'en';

      button.addEventListener('click', async () => {
        // Track popup opened
        window.plausible?.('popup_opened', { props: { locale } });

        button.disabled = true;
        try {
          await loadCalendly();
          openCalendlyPopup(locale);
        } catch (error) {
          console.error('Failed to load Calendly:', error);
        } finally {
          button.disabled = false;
        }
      });
    </script>
  </div>
</section>
