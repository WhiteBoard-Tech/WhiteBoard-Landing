---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import ServiceCard from '../ServiceCard.astro';
import LayersAnimation from '../LayersAnimation.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  { key: 'ai', icon: 'cpu' as const },
  { key: 'software', icon: 'code' as const },
  { key: 'consulting', icon: 'compass' as const },
  { key: 'governance', icon: 'shield' as const },
];
---

<section id="services" class="py-20 lg:py-28 bg-canvas-000 border-b border-canvas-200">
  <div class="max-w-[1240px] mx-auto px-5 lg:px-8">
    <div class="flex flex-wrap justify-between items-end gap-8 mb-14">
      <div>
        <p class="font-mono text-xs text-graphite-500 mb-4">{t('services.kicker')}</p>
        <h2 class="text-[38px] lg:text-[56px] leading-none font-bold tracking-[-1.2px] lg:tracking-[-2px] max-w-[14em]">
          {t('services.title')}
        </h2>
      </div>
      <p class="text-[17px] text-graphite-600 max-w-[30em]">{t('services.subtitle')}</p>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-4">
      <LayersAnimation />
      <div class="grid sm:grid-cols-2 gap-4">
        {services.map((service, i) => (
          <ServiceCard
            index={i + 1}
            title={t(`services.${service.key}.title` as any)}
            tagline={t(`services.${service.key}.tagline` as any)}
            icon={service.icon}
          />
        ))}
      </div>
    </div>
  </div>
</section>
