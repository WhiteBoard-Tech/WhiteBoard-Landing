---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import ServiceCard from '../ServiceCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  { key: 'platformReady', icon: 'layers' as const },
  { key: 'skinInGame', icon: 'handshake' as const },
  { key: 'governance', icon: 'target' as const },
  { key: 'aiNative', icon: 'cpu' as const },
];
---

<section id="services" class="py-16 sm:py-20 lg:py-24 bg-brand-carbon">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section title -->
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-12 lg:mb-16">
      {t('services.title')}
    </h2>

    <!-- Services grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {services.map((service) => (
        <ServiceCard
          title={t(`services.${service.key}.title` as any)}
          tagline={t(`services.${service.key}.tagline` as any)}
          icon={service.icon}
        />
      ))}
    </div>
  </div>
</section>
