---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-100 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <div class="text-sm text-gray-500 text-center sm:text-left space-y-1">
        <p>&copy; {currentYear} WHITEBOARD SAS. {t('footer.copyright')}</p>
        <p>NIT 902.078.099-6 &middot; Calle 12 A 71 B 40, Torre 5 Apartamento 203, Bogotá D.C., Colombia</p>
      </div>

      <nav class="flex flex-wrap justify-center gap-6" aria-label="Footer navigation">
        <a
          href="mailto:whiteboard@whibotech.com"
          class="text-sm text-gray-500 hover:text-black transition-colors"
        >
          whiteboard@whibotech.com
        </a>
        <a
          href={`/${lang}/privacy`}
          class="text-sm text-gray-500 hover:text-black transition-colors"
        >
          {t('footer.privacy')}
        </a>
        <a
          href={`/${lang}/terms`}
          class="text-sm text-gray-500 hover:text-black transition-colors"
        >
          {t('footer.terms')}
        </a>
      </nav>
    </div>
  </div>
</footer>
