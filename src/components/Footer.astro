---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-brand-slate bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-400">
        &copy; {currentYear} Whiteboard. {t('footer.copyright')}
      </p>

      <nav class="flex gap-6" aria-label="Footer navigation">
        <a
          href={`/${lang}/privacy`}
          class="text-sm text-gray-400 hover:text-brand-pulse transition-colors"
        >
          {t('footer.privacy')}
        </a>
        <a
          href={`/${lang}/terms`}
          class="text-sm text-gray-400 hover:text-brand-pulse transition-colors"
        >
          {t('footer.terms')}
        </a>
      </nav>
    </div>
  </div>
</footer>
