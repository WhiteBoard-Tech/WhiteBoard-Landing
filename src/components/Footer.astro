---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Logo from "./Logo.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-graphite-800 bg-ink-900 text-graphite-400">
  <div class="max-w-[1240px] mx-auto px-5 lg:px-8 pt-12 pb-14 flex flex-wrap justify-between items-end gap-8">
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-2.5 text-canvas-050">
        <Logo size="sm" />
        <span class="text-lg font-bold tracking-[-0.4px]">Whiteboard</span>
      </div>
      <div class="text-[13px] leading-relaxed space-y-0.5">
        <p>&copy; {currentYear} WHITEBOARD SAS. {t('footer.copyright')}</p>
        <p class="font-mono text-xs">NIT 902.078.099-6 &middot; Bogotá D.C., Colombia</p>
      </div>
    </div>

    <nav class="flex gap-6" aria-label="Footer navigation">
      <a
        href={`/${lang}/privacy`}
        class="text-[13px] text-canvas-300 hover:text-canvas-050 focus-visible:outline-marker-500 transition-colors"
      >
        {t('footer.privacy')}
      </a>
      <a
        href={`/${lang}/terms`}
        class="text-[13px] text-canvas-300 hover:text-canvas-050 focus-visible:outline-marker-500 transition-colors"
      >
        {t('footer.terms')}
      </a>
    </nav>
  </div>
</footer>
