---
export interface Props {
  title: string;
  tagline: string;
  icon: 'rocket' | 'chart' | 'cpu' | 'plug';
}

const { title, tagline, icon } = Astro.props;

const iconPaths: Record<Props['icon'], string> = {
  rocket: 'M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z M14.5 17.5 17 15l-3-3',
  chart: 'M3 3v18h18 M18 17V9 M13 17V5 M8 17v-3',
  cpu: 'M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0H5a2 2 0 0 1-2-2v-4m6 6h10a2 2 0 0 0 2-2v-4M3 9h18M3 15h18M9 9v6m6-6v6',
  plug: 'M12 22v-5 M7 12V9a5 5 0 0 1 10 0v3 M5 12h14a1 1 0 0 1 1 1v1a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-1a1 1 0 0 1 1-1z',
};
---

<div class="flex flex-col items-center text-center p-6 border border-gray-200 rounded-lg hover:shadow-lg transition-shadow duration-300">
  <!-- Icon container -->
  <div class="w-12 h-12 rounded-full bg-gray-50 flex items-center justify-center mb-4">
    <svg
      class="w-6 h-6 text-gray-700"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={iconPaths[icon]} />
    </svg>
  </div>

  <!-- Title -->
  <h3 class="text-lg font-semibold text-black mb-2">
    {title}
  </h3>

  <!-- Tagline -->
  <p class="text-gray-600 text-sm leading-relaxed">
    {tagline}
  </p>
</div>
