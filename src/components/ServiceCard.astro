---
export interface Props {
  title: string;
  tagline: string;
  icon: 'layers' | 'handshake' | 'target' | 'cpu';
}

const { title, tagline, icon } = Astro.props;

const iconPaths: Record<Props['icon'], string> = {
  // Layers - stacked components representing platform foundation
  layers: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  // Handshake - partnership and equity alignment
  handshake: 'M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 0C1.46 6.7 1.33 10.28 4 13l8 8 8-8c2.67-2.72 2.54-6.3.42-8.42zM12 5.36l.78.78a1 1 0 0 0 1.41 0l.79-.79a3.4 3.4 0 0 1 4.82 0 3.4 3.4 0 0 1 0 4.82L12 18l-7.8-7.83a3.4 3.4 0 0 1 0-4.82 3.4 3.4 0 0 1 4.82 0l.79.79a1 1 0 0 0 1.41 0l.78-.78z',
  // Target - goals and accountability
  target: 'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 18c3.314 0 6-2.686 6-6s-2.686-6-6-6-6 2.686-6 6 2.686 6 6 6zM12 14c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z',
  // CPU - AI and data native (keep existing)
  cpu: 'M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0H5a2 2 0 0 1-2-2v-4m6 6h10a2 2 0 0 0 2-2v-4M3 9h18M3 15h18M9 9v6m6-6v6',
};
---

<div class="flex flex-col items-center text-center p-6 border border-gray-200 rounded-lg hover:shadow-lg transition-shadow duration-300">
  <!-- Icon container -->
  <div class="w-14 h-14 rounded-full bg-black flex items-center justify-center mb-5">
    <svg
      class="w-7 h-7 text-white"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={iconPaths[icon]} />
    </svg>
  </div>

  <!-- Title -->
  <h3 class="text-lg font-semibold text-black mb-2">
    {title}
  </h3>

  <!-- Tagline -->
  <p class="text-gray-600 text-sm leading-relaxed">
    {tagline}
  </p>
</div>
