---
import "@fontsource-variable/archivo";
import "@fontsource-variable/jetbrains-mono";
import "@/styles/global.css";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import Logo from "@components/Logo.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t("site.title"),
  description = t("site.description"),
} = Astro.props;

const navLinks = [
  { href: "#services", key: "nav.services" },
  { href: "#process", key: "nav.process" },
  { href: "#products", key: "nav.products" },
  { href: "#governance", key: "nav.governance" },
  { href: "#faq", key: "nav.faq" },
] as const;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Preconnect for faster font loading -->
    <link rel="preconnect" href="/" crossorigin />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Plausible Analytics (privacy-first, no cookies) -->
    <script defer data-domain="whiteboard.co" src="https://plausible.io/js/script.js"></script>
  </head>
  <body class="min-h-screen bg-canvas-050 text-ink-900 font-sans antialiased">
    <!-- Skip to content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-ink-900 focus:text-canvas-050"
    >
      Skip to content
    </a>

    <!-- Header with language switcher -->
    <header class="fixed top-0 left-0 right-0 z-40 bg-canvas-050/95 backdrop-blur-md border-b border-canvas-200">
      <div class="max-w-[1240px] mx-auto px-5 lg:px-8">
        <div class="flex items-center justify-between gap-6 h-16">
          <!-- Logo with W mark -->
          <a href={`/${lang}/`} class="flex items-center gap-2.5" aria-label="Whiteboard - Home">
            <Logo size="sm" class="text-ink-900" />
            <span class="text-[19px] font-bold tracking-[-0.5px] text-ink-900">
              Whiteboard
            </span>
          </a>

          <nav class="hidden lg:flex gap-7" aria-label="Sections">
            {navLinks.map((link) => (
              <a href={link.href} class="text-sm font-medium text-graphite-600 hover:text-ink-900 transition-colors">
                {t(link.key)}
              </a>
            ))}
          </nav>

          <div class="flex items-center gap-3">
            <LanguageSwitcher />
            <a
              href="#contact"
              class="hidden sm:inline-flex items-center min-h-10 px-4 text-sm font-semibold rounded-md bg-ink-900 text-canvas-050 hover:bg-graphite-800 transition-colors"
            >
              {t("nav.apply")}
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main content with top padding for fixed header -->
    <main id="main-content" class="pt-16">
      <slot />
    </main>

    <!-- Footer component -->
    <Footer />

    <script>
      // Section animations run only while they are on screen
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((entry) => entry.target.classList.toggle("is-visible", entry.isIntersecting)),
        { threshold: 0.3 },
      );
      document.querySelectorAll("[data-animate]").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
